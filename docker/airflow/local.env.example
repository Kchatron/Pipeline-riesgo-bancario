# Plantilla sin secretos. prepare_local.py genera un archivo equivalente fuera de Git.
COMPOSE_PROJECT_NAME=historico-airflow-ejemplo
# ID completo de una imagen local ya construida y validada; no usar una etiqueta.
AIRFLOW_IMAGE=REEMPLAZAR_POR_ID_COMPLETO_SHA256_DE_IMAGEN_VALIDADA
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_LOGS_DIR=/ruta/externa/nueva/logs
AIRFLOW_AUTH_DIR=/ruta/externa/nueva/auth
PIPELINE_MOUNT_DIR=/ruta/externa/nueva/data
SBS_SOURCE_DIR=/ruta/solo/lectura/SBS
AIRFLOW_SECRETS_FILE=/ruta/externa/nueva/secrets/airflow.env
POSTGRES_SECRETS_FILE=/ruta/externa/nueva/secrets/postgres.env
